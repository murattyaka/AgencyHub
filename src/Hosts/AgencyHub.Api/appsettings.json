{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "agencyhub-api",
    "Audience": "agencyhub-web",
    "SigningKey": "",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "14.00:00:00"
  },
  "AgencyRegistration": {
    "Enabled": false
  },
  "RateLimiting": {
    "GlobalPermitLimitPerMinute": 300,
    "AuthenticationPermitLimitPerMinute": 5
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  }
}
